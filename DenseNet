    def contour(image, box_size_percentage=0.1):
        img_resized = cv2.resize(image, (224, 224))  # Resize for consistent input size
        img_np = np.array(img_resized)

        # Simple thresholding for demo (customize this)
        gray = cv2.cvtColor(img_resized, cv2.COLOR_BGR2GRAY)
        _, thresh = cv2.threshold(gray, 120, 255, cv2.THRESH_BINARY)

        # Find contours
        contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

        # Draw contours on the original image
        for cnt in contours:
            cv2.drawContours(img_resized, [cnt], 0, (0, 255, 0), 2)

        # Get image dimensions
        height, width, _ = image.shape

        # Calculate box dimensions (as a percentage of image size)
        box_width = int(width * box_size_percentage)
        box_height = int(height * box_size_percentage)

        x_start = random.randint(100, width - box_width - 200)
        y_start = random.randint(100, height - box_height - 200)

        # Define the bottom-right corner based on the box size
        x_end = x_start + box_width
        y_end = y_start + box_height

        # Draw the rectangle (green box with thickness of 2)
        image_contoured = cv2.rectangle(image.copy(), (x_start, y_start), (x_end, y_end), (0, 255, 0), 2)

        return image_contoured

